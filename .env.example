# Optional in development, required for the live event.

# Shared storage for passes and gate check-ins (see supabase/schema.sql). Without these, passes live in
# a local file / server memory, which is fine for a demo but not for several gate phones.
# Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PIN gate staff type on /gate to scan and check in passes. Use 6 or more characters. In development it defaults to 2026.
GATE_PIN=
# A long random string that signs staff sessions (for example: openssl rand -base64 32). If it is missing in
# production, the database key above is used instead; with neither, gate check-in stays off.
GATE_SECRET=

# The public address, so share previews use the right domain (e.g. https://iaaf-rows.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Leave unset while the page is a draft (search engines are told to stay away).
# Set to true after the client approves, then redeploy, to let Google index the page.
NEXT_PUBLIC_INDEXABLE=
